{
  "name": "cloving-zapier",
  "version": "2.0.0",
  "private": true,
  "description": "End-to-end encrypted Zapier integration for local Cloving workflows",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./relay": "./dist/relay.js"
  },
  "bin": {
    "cloving-zapier": "dist/cli.js",
    "cloving-mcp": "dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "check": "npm run build && npm test",
    "_zapier-build": "npm run build"
  },
  "dependencies": {
    "@hpke/core": "1.10.0",
    "zapier-platform-core": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "6.0.3",
    "zapier-platform-cli": "19.3.0"
  }
}
